@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(Qt6 COMPONENTS Core Widgets Network Concurrent)

# Find optional dependencies
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND)
    pkg_check_modules(OPENGL gl)
    pkg_check_modules(VULKAN vulkan)
    pkg_check_modules(MBEDTLS mbedtls)
    pkg_check_modules(LIBCURL libcurl)
    pkg_check_modules(ZLIB zlib)
endif()

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/LeviLinuxTargets.cmake")

# Version info
set(LEVI_LINUX_VERSION "@PROJECT_VERSION@")
set(LEVI_LINUX_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(LEVI_LINUX_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(LEVI_LINUX_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

check_required_components(LeviLinux)